# Server .env for the Hetzner Docker Compose deploy.
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.
#
# These feed BOTH compose variable interpolation (the db service) and the app's
# env_file. SQL_DB_HOST / SQL_DB_PORT / SQL_DB_SSL are set by docker-compose.yml
# itself (app talks to the `db` service over the private network), so leave them
# out here.

# --- Database (Postgres container) ---
SQL_DB_NAME=finmon
SQL_DB_USER=finmon
SQL_DB_PASSWORD=change-me-to-a-long-random-password

# --- Auth ---
# Required in production. Generate once with: openssl rand -base64 32
# Keep it STABLE — rotating it invalidates all existing sessions.
BETTER_AUTH_SECRET=
# Full HTTPS origin of the app behind Cloudflare + nginx. Must match the domain.
BETTER_AUTH_URL=https://finmon.uk

# --- Receipt scanning (optional) ---
# Without OPENAI_API_KEY, receipt scanning is disabled and returns a friendly
# error; transactions otherwise work unchanged.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
