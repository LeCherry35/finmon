# Server .env for the DigitalOcean Docker Compose deploy.
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.
#
# These feed BOTH compose variable interpolation (the db service) and the app's
# env_file. SQL_DB_HOST / SQL_DB_PORT / SQL_DB_SSL are set by docker-compose.yml
# itself (app talks to the `db` service over the private network), so leave them
# out here.

# --- Database (Postgres container) ---
SQL_DB_NAME=finmon
SQL_DB_USER=finmon
SQL_DB_PASSWORD=change-me-to-a-long-random-password

# --- Auth ---
# Required in production. Generate once with: openssl rand -base64 32
# Keep it STABLE — rotating it invalidates all existing sessions.
BETTER_AUTH_SECRET=
# Full HTTPS origin of the app behind Cloudflare + nginx. Must match the domain.
BETTER_AUTH_URL=https://finmon.uk

# --- Receipt scanning (optional) ---
# Without OPENAI_API_KEY, receipt scanning is disabled and returns a friendly
# error; transactions otherwise work unchanged.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AI assistant (opencode sidecar) ---
# Password between the app and the opencode container (never exposed publicly).
# Generate with: openssl rand -base64 32. Required by docker-compose.yml.
OPENCODE_SERVER_PASSWORD=
# Model as provider/model. opencode/* free models (e.g. opencode/big-pickle)
# need no key; openai/* uses OPENAI_API_KEY, anthropic/* uses ANTHROPIC_API_KEY.
# List what's available with: opencode models opencode
AGENT_MODEL=opencode/big-pickle
# ANTHROPIC_API_KEY=
# A model behind a LiteLLM (OpenAI-compatible) server: AGENT_MODEL=litellm/<model name
# as LiteLLM knows it>. The key is passed only to the opencode container.
# AGENT_MODEL=litellm/<model>
# LITELLM_BASE_URL=https://<litellm-host>/v1
# LITELLM_API_KEY=
# Optional: separate HMAC secret for the per-user MCP tokens (defaults to BETTER_AUTH_SECRET).
# AGENT_TOKEN_SECRET=
